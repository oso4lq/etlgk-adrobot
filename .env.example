# Keitaro tracker
KEITARO_BASE_URL=https://your-tracker.example.com
KEITARO_API_KEY=your-admin-api-key
KEITARO_TIMEOUT_SECONDS=10
KEITARO_MAX_RETRIES=2
# Writes to Keitaro are allowed only for campaigns whose name starts with this prefix (empty = no limit)
KEITARO_WRITE_NAME_PREFIX=

# Database. Default: SQLite file in backend/. Example for Postgres: postgresql+psycopg://user:pass@localhost/adrobot
# DATABASE_URL=

# Campaign creator: Keitaro dictionaries by name or numeric id
CAMPAIGN_DOMAIN=
CAMPAIGN_GROUP=
CAMPAIGN_TRAFFIC_SOURCE=
REDIRECT_URL=https://google.com

OFFERS_CACHE_TTL_SECONDS=300
CORS_ORIGINS=["http://localhost:4200"]

# Keitaro admin UI credentials (manual checks via browser only, not used by the app)
KEITARO_ADMIN_LOGIN=
KEITARO_ADMIN_PASSWORD=
