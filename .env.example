# One .env at the repository root is used by the backend, the tools and docker compose.
# Keitaro tracker. Address and API key come from the Keitaro admin ("API ключ" button / profile).
KEITARO_BASE_URL=https://your-tracker.example.com
KEITARO_API_KEY=your-admin-api-key
KEITARO_TIMEOUT_SECONDS=10
KEITARO_MAX_RETRIES=2
# Writes to Keitaro are allowed only for campaigns whose name starts with this prefix (empty = no limit).
# Recommended for any shared or test tracker, for example: test_<your nick>_
KEITARO_WRITE_NAME_PREFIX=

# Database. Default: SQLite file in backend/. Example for Postgres: postgresql+psycopg://user:pass@localhost/adrobot
# In Docker compose sets DATABASE_URL itself (SQLite in a volume): leave it unset here.
# DATABASE_URL=

# Campaign creator: Keitaro dictionaries by name or numeric id
# Example for the training emulator: the domain is set by id (its name differs from the real one),
# group and source by name:
# CAMPAIGN_DOMAIN=1813
# CAMPAIGN_GROUP=FORTESTS
# CAMPAIGN_TRAFFIC_SOURCE=FORTESTS
CAMPAIGN_DOMAIN=
CAMPAIGN_GROUP=
CAMPAIGN_TRAFFIC_SOURCE=
REDIRECT_URL=https://google.com

OFFERS_CACHE_TTL_SECONDS=300
# Origins allowed to call the API from a browser. Needed only for "pnpm start" (dev server on :4200);
# not needed in Docker: nginx serves the UI and the API from one origin.
CORS_ORIGINS=["http://localhost:4200"]

# Keitaro admin UI credentials (manual checks via browser only, not used by the app).
# The training emulator has no login/password: sign in there through GitHub, leave these empty.
KEITARO_ADMIN_LOGIN=
KEITARO_ADMIN_PASSWORD=
